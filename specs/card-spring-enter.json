{
  "name": "card-spring-enter",
  "duration": 1.2,
  "fps": 30,
  "lottie_compatible": true,
  "assets": { "card": "card.png" },
  "layers": [
    {
      "id": "card",
      "property": "translateY",
      "from": 120, "to": 0,
      "easing": "spring_overshoot",
      "spring": { "stiffness": 200, "damping": 22, "mass": 1 },
      "render_compatible": true,
      "lottie_compatible": true
    },
    {
      "id": "card",
      "property": "opacity",
      "from": 0, "to": 1,
      "easing": "ease_out",
      "render_compatible": true,
      "lottie_compatible": true
    }
  ]
}
