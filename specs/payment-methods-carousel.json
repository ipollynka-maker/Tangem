{
  "name": "payment-methods-carousel",
  "duration": 4.5,
  "fps": 30,
  "width": 800,
  "height": 600,
  "lottie_compatible": false,
  "assets": {
    "visa-card":       "cards/visa.svg",
    "mastercard-card": "cards/mastercard.svg",
    "applepay-card":   "cards/apple-pay.svg",
    "ach-card":        "cards/ach.svg",
    "wire-card":       "cards/wire.svg"
  },

  "_comment": "Three phases: (1) 3D frontal carousel spin 0–2.5 s, (2) select hold 2.5–3.0 s, (3) unwind+exit 3.0–4.5 s.",

  "carousel": {
    "radius": 280,
    "card_count": 5,
    "axis": "Y",
    "perspective": 900,
    "proximity_scale_min": 1.0,
    "proximity_scale_max": 1.2,
    "_note": "Card positions: x=R·sin(θ), z=R·cos(θ). ProximityScale=1.0+0.2·(z+R)/(2R). Cards at θ=[0,72,144,216,288]°."
  },

  "phases": [
    { "id": "carousel", "start": 0.0, "end": 2.5, "_note": "Rig rotates 360° around Y; Visa lands at θ=0 (front-center)." },
    { "id": "select",   "start": 2.5, "end": 3.0, "_note": "Carousel freezes. Selection ring pulses on Visa card." },
    { "id": "resolve",  "start": 3.0, "end": 4.5, "_note": "Non-Visa cards unwind to a horizontal line then exit downward. Visa centers." }
  ],

  "layers": [

    {
      "id": "carousel-rig",
      "property": "rotateY",
      "from": 0,
      "to": 360,
      "easing": "ease_in_out",
      "phase": "carousel",
      "_note": "Single rotation 0→360° over 2.5 s. Container holds all five cards. Not render-compilable; handled in AE and CSS perspective manually.",
      "render_compatible": false,
      "lottie_compatible": false
    },

    {
      "id": "visa-card",
      "property": "scale",
      "from": 1.2,
      "to": 1.0,
      "easing": "spring_overshoot",
      "spring": { "stiffness": 200, "damping": 24, "mass": 1 },
      "start_at": 3.0,
      "_note": "Visa holds proximity-scale 1.2 through carousel. Settles to 1.0 on resolve.",
      "render_compatible": true,
      "lottie_compatible": false
    },

    {
      "id": "mastercard-card",
      "property": "translateX",
      "from": 266,
      "to": 160,
      "easing": "spring_overshoot",
      "spring": { "stiffness": 160, "damping": 20, "mass": 1 },
      "start_at": 3.0,
      "_note": "from=R·sin(72°)≈266. Unwinds leftward to line position x=160.",
      "render_compatible": true,
      "lottie_compatible": false
    },
    {
      "id": "mastercard-card",
      "property": "translateY",
      "from": 0,
      "to": 520,
      "easing": "ease_in_out",
      "start_at": 3.0,
      "render_compatible": true,
      "lottie_compatible": false
    },
    {
      "id": "mastercard-card",
      "property": "opacity",
      "from": 1,
      "to": 0,
      "easing": "ease_out",
      "start_at": 3.0,
      "render_compatible": true,
      "lottie_compatible": false
    },

    {
      "id": "applepay-card",
      "property": "translateX",
      "from": 165,
      "to": 320,
      "easing": "spring_overshoot",
      "spring": { "stiffness": 140, "damping": 18, "mass": 1 },
      "start_at": 3.0,
      "_note": "from=R·sin(144°)≈165. Expands right to x=320.",
      "render_compatible": true,
      "lottie_compatible": false
    },
    {
      "id": "applepay-card",
      "property": "translateY",
      "from": 0,
      "to": 520,
      "easing": "ease_in_out",
      "start_at": 3.0,
      "render_compatible": true,
      "lottie_compatible": false
    },
    {
      "id": "applepay-card",
      "property": "opacity",
      "from": 1,
      "to": 0,
      "easing": "ease_out",
      "start_at": 3.0,
      "render_compatible": true,
      "lottie_compatible": false
    },

    {
      "id": "ach-card",
      "property": "translateX",
      "from": -165,
      "to": -160,
      "easing": "spring_overshoot",
      "spring": { "stiffness": 140, "damping": 18, "mass": 1 },
      "start_at": 3.0,
      "_note": "from=R·sin(216°)≈-165. Nearly in place; slight spring settle.",
      "render_compatible": true,
      "lottie_compatible": false
    },
    {
      "id": "ach-card",
      "property": "translateY",
      "from": 0,
      "to": 520,
      "easing": "ease_in_out",
      "start_at": 3.0,
      "render_compatible": true,
      "lottie_compatible": false
    },
    {
      "id": "ach-card",
      "property": "opacity",
      "from": 1,
      "to": 0,
      "easing": "ease_out",
      "start_at": 3.0,
      "render_compatible": true,
      "lottie_compatible": false
    },

    {
      "id": "wire-card",
      "property": "translateX",
      "from": -266,
      "to": -320,
      "easing": "spring_overshoot",
      "spring": { "stiffness": 140, "damping": 18, "mass": 1 },
      "start_at": 3.0,
      "_note": "from=R·sin(288°)≈-266. Expands left to x=-320.",
      "render_compatible": true,
      "lottie_compatible": false
    },
    {
      "id": "wire-card",
      "property": "translateY",
      "from": 0,
      "to": 520,
      "easing": "ease_in_out",
      "start_at": 3.0,
      "render_compatible": true,
      "lottie_compatible": false
    },
    {
      "id": "wire-card",
      "property": "opacity",
      "from": 1,
      "to": 0,
      "easing": "ease_out",
      "start_at": 3.0,
      "render_compatible": true,
      "lottie_compatible": false
    },

    {
      "id": "selection-ring",
      "property": "opacity",
      "from": 0,
      "to": 1,
      "easing": "ease_out",
      "start_at": 2.5,
      "_note": "Highlight ring appears on Visa at selection moment. Sits behind card at same center.",
      "render_compatible": true,
      "lottie_compatible": false
    },
    {
      "id": "selection-ring",
      "property": "scale",
      "from": 1.35,
      "to": 1.05,
      "easing": "spring_overshoot",
      "spring": { "stiffness": 220, "damping": 16, "mass": 1 },
      "start_at": 2.5,
      "render_compatible": true,
      "lottie_compatible": false
    }

  ]
}
